module alu #(
    parameter WIDTH = 4
)(
    input  [WIDTH-1:0] a,b,
    input  [2:0] sel,
    output reg [WIDTH-1:0] y,
    output reg carry
);

always @(*) begin
     y     = 0;
    carry = 0;

    case(sel)

        
        3'b000:
        begin
            {carry,y} = a + b;
        end

      
        3'b001:
        begin
            {carry,y} = a - b;
        end

       
        3'b010:
        begin
            y = a * b;
        end

       
        3'b011:
        begin
            if(b != 0)
                y = a / b;
            else
                y = 0;
        end

        
        3'b100:
        begin
            y = a ^ b;
        end

        
        3'b101:
        begin
            y = ~a;
        end

        3'b110:
        begin
            y = 0;
            carry = 0;
        end

        default:
        begin
            y = 0;
            carry = 0;
        end

    endcase
end

endmodule

