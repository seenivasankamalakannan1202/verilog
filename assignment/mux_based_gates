 <=============behavioural_type============================>

module or_mux(
  	input a,b,
  	input sel,
  output  reg y);
  
  always@(*) begin
    if(a==1'b0 && b==1'b0)
      begin
        y=1'b0;
      end
    
      else
        begin
        y=1'b1;
    end
  end
endmodule

